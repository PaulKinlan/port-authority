{
  // Port Authority (working name). One Worker script, deployed under several
  // names so that each demo site gets its own real origin.
  "name": "portauthority",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Set both when the main site has its own domain and the demo sites stay on workers.dev.
  "vars": { "MAIN_HOST": "port-authority.dev", "DEMO_SUFFIX": ".kinlan-test.workers.dev" },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }, { "name": "LAB", "class_name": "Lab" }, { "name": "MEET", "class_name": "Meet" }, { "name": "ROUTER", "class_name": "Router" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["Hub"], "deleted_classes": ["Relay"] },
    { "tag": "v3", "new_sqlite_classes": ["Lab"] },
    { "tag": "v4", "new_sqlite_classes": ["Meet"] },
    { "tag": "v5", "new_sqlite_classes": ["Router"] }
  ]
}
