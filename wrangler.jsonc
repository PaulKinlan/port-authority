{
  // Port Authority (working name). One Worker script, deployed under several
  // names so that each demo site gets its own real origin.
  //
  // This file is the main site (port-authority.dev) and is also what
  // `wrangler dev` runs locally, where one Worker stands in for every site.
  // The demo sites have their own files in deploy/.
  //
  // Deploys are automatic: Cloudflare Workers Builds runs `npx wrangler deploy`
  // for each Worker on every push to main. See "Deploy" in README.md.
  "name": "portauthority",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // port-authority.dev is attached to this Worker as a custom domain on
  // Cloudflare. It is not listed under "routes" here because `wrangler dev`
  // would then answer every local request as that host, and the script picks
  // the site by hostname. A deploy leaves the domain attached.
  "assets": {
    "directory": "sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The main site and the AI router each have a domain of their own. The demo
  // sites stay on workers.dev. Every Worker has the same three settings,
  // because each one tells its pages where the other sites are.
  "vars": { "MAIN_HOST": "port-authority.dev", "ROUTER_HOST": "llmchannel.dev", "DEMO_SUFFIX": ".kinlan-test.workers.dev" },
  // There was a Router class here too, for the AI router's list of grants. The
  // router keeps nothing on a server now, and migration v6 deleted the class.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }, { "name": "LAB", "class_name": "Lab" }, { "name": "MEET", "class_name": "Meet" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Relay"] },
    { "tag": "v2", "new_sqlite_classes": ["Hub"], "deleted_classes": ["Relay"] },
    { "tag": "v3", "new_sqlite_classes": ["Lab"] },
    { "tag": "v4", "new_sqlite_classes": ["Meet"] },
    { "tag": "v5", "new_sqlite_classes": ["Router"] },
    { "tag": "v6", "deleted_classes": ["Router"] }
  ]
}
