{
  // The AI router's origin: the same script and files as the main site, under
  // its own Worker name. It keeps the list of grants in a Router class of its own.
  "name": "pa-router",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // llmchannel.dev is attached to this Worker as a custom domain on Cloudflare,
  // and ROUTER_HOST tells the script that requests for it are for the router.
  // The same ROUTER_HOST is in ../wrangler.jsonc and the other files in this
  // folder, because each Worker tells its pages where the router is. The old
  // workers.dev address still answers as the router, so that keys someone
  // saved there can still be removed.
  "vars": { "MAIN_HOST": "port-authority.dev", "ROUTER_HOST": "llmchannel.dev", "DEMO_SUFFIX": ".kinlan-test.workers.dev" },
  "durable_objects": { "bindings": [{ "name": "ROUTER", "class_name": "Router" }] },
  "migrations": [{ "tag": "r1", "new_sqlite_classes": ["Router"] }]
}
