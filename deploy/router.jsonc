{
  // The AI router's origin: the same script and files as the main site, under
  // its own Worker name. It keeps the list of grants in a Router class of its own.
  "name": "pa-router",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../sites",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // To give the router a domain of its own, attach the domain to this Worker as
  // a custom domain on Cloudflare, then add "ROUTER_HOST": "<the domain>" to
  // "vars" here, in ../wrangler.jsonc and in the other files in this folder.
  // Every Worker needs it, because each one tells its pages where the router is.
  "vars": { "MAIN_HOST": "port-authority.dev", "DEMO_SUFFIX": ".kinlan-test.workers.dev" },
  "durable_objects": { "bindings": [{ "name": "ROUTER", "class_name": "Router" }] },
  "migrations": [{ "tag": "r1", "new_sqlite_classes": ["Router"] }]
}
